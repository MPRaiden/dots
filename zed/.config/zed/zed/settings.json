{
  "icon_theme": "Warm Charmed Icons",
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "lsp_highlight_debounce": 86400000,
  "vim_mode": true,
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "border": "#1E1E2E",
      "border.variant": "#1E1E2E",
      "title_bar.background": "#1E1E2E",
      "panel.background": "#1E1E2E",
      "status_bar.background": "#1E1E2E",
      "toolbar.background": "#1E1E2E"
    },
    "Catppuccin Latte": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "border": "#EFF1F5",
      "border.variant": "#EFF1F5",
      "title_bar.background": "#EFF1F5",
      "panel.background": "#EFF1F5",
      "status_bar.background": "#EFF1F5",
      "editor.document_highlight.bracket_background": "#00000000"
    }
  },
  "relative_line_numbers": "enabled",
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "starts_open": true,
    "auto_fold_dirs": false,
    "indent_guides": {
      "show": "never"
    }
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_menu": false,
    "show_project_items": false
  },
  "status_bar": {
    "experimental.show": false
  },
  "file_finder": {
    "modal_max_width": "small"
  },
  "scrollbar": {
    "show": "never"
  },
  "gutter": {
    "min_line_number_digits": 0,
    "runnables": false
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "auto_update": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1
}
